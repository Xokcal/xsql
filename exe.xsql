create table teacher(
    id string comment 'teacher id',
    name string comment 'teacher name',
    gender string comment 'gender',
    age string comment 'age',
    subject string comment 'teaching subject',
    title string comment 'professional title',
    phone string comment 'phone number',
    email string comment 'email address',
    office string comment 'office location',
    salary string comment 'monthly salary'
) comment 'teacher info';


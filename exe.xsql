create table product(
    product_id string comment 'product id',
    product_name string comment 'product name',
    category string comment 'category',
    brand string comment 'brand',
    price string comment 'unit price',
    stock string comment 'stock quantity',
    supplier_id string comment 'supplier id',
    warehouse_code string comment 'warehouse code',
    production_date string comment 'production date',
    expiry_date string comment 'expiry date'
) comment 'product info';


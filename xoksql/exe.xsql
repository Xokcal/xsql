CREATE TABLE users (
    id       STRING,
    name     STRING,
    age      STRING,
    email    STRING,
    status   STRING
);

CREATE TABLE orders (
    order_id   STRING,
    user_id    STRING,
    product    STRING,
    quantity   STRING,
    price      STRING
);

CREATE TABLE logs (
    log_id     STRING,
    user_id    STRING,
    action     STRING,
    timestamp  STRING
);

CREATE TABLE user (
    id STRING COMMENT 'userid',
    username STRING COMMENT 'loginname',
    password STRING COMMENT 'password',
    phone STRING COMMENT 'phonenumber',
    email STRING COMMENT 'email',
    status STRING COMMENT '0normal1disabled',
    created_at STRING COMMENT 'createtime',
    updated_at STRING COMMENT 'updatetime'
)COMMENT 'user';

